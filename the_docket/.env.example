# Django and database settings
# Required when DJANGO_DEBUG is False.
DJANGO_SECRET_KEY=
# False in production; use True for local development.
DJANGO_DEBUG=False
# Comma-separated hostnames accepted by Django.
DJANGO_ALLOWED_HOSTS=
# Comma-separated trusted origins, including the scheme.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional; leave blank locally to use SQLite.
DATABASE_URL=
# Public URL used by the Wagtail admin.
WAGTAILADMIN_BASE_URL=

# Mailchimp audience and monthly draft campaigns
# Mailchimp API key ending with its data-centre suffix, such as -us21.
MAILCHIMP_API_KEY=
# ID of the Mailchimp Audience.
MAILCHIMP_AUDIENCE_ID=
# Reply-to address set on monthly draft campaigns.
MAILCHIMP_REPLY_TO=
# Address notified when someone subscribes.
OWNER_NOTIFICATION_EMAIL=
# Public site URL used for links in monthly digests.
PUBLIC_BASE_URL=

# SMTP settings for subscriber and owner emails
# SMTP server hostname; blank selects Django's console email backend.
EMAIL_HOST=
# SMTP server port.
EMAIL_PORT=587
# SMTP login username.
EMAIL_HOST_USER=
# SMTP app password or equivalent credential.
EMAIL_HOST_PASSWORD=
# Sender address for subscriber emails.
DEFAULT_FROM_EMAIL=

# Render Python runtime, matching local Python 3.13.3.
PYTHON_VERSION=3.13.3

# Optional first Wagtail administrator (all three must be set)
# Initial administrator username.
DJANGO_SUPERUSER_USERNAME=
# Initial administrator email.
DJANGO_SUPERUSER_EMAIL=
# Initial administrator password; keep it secret.
DJANGO_SUPERUSER_PASSWORD=
